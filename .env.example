# Sasti Dawai ML Subsystem Environment Configuration Template
# Copy this file to .env and populate with your own credentials.
# NEVER commit .env to version control.

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Local Storage / Database Configuration
# Default uses local SQLite; set PostgreSQL URL when provisioning Neon/Supabase
DATABASE_URL=sqlite:///./sasti_dawai_catalogue.db

# Vision-Language Model Provider Credentials
# Google Gemini API key (for primary VLM extraction)
GEMINI_API_KEY=your_gemini_api_key_here
VLM_MODEL_NAME=gemini-2.5-flash
VLM_TEMPERATURE=0.0
VLM_TIMEOUT_SECONDS=10.0

# Perception & Quality Gate Calibration Thresholds
BLUR_LAPLACIAN_THRESHOLD=100.0
GLARE_RATIO_MAX=0.15
CONFIDENCE_THRESHOLD_CRITICAL=0.85

# Dataset Paths (Relative to repository root)
JAN_AUSHADHI_CSV_PATH=data/raw/jan_aushadhi_products.csv
INDIAN_MEDICINES_CSV_PATH=data/raw/indian_medicines.csv
